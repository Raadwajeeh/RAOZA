APP_NAME=RAOZA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
TRUSTED_PROXIES=
RETENTION_PRUNING_ENABLED=false
RETENTION_ANALYTICS_DAYS=
RETENTION_SESSIONS_DAYS=
RETENTION_CONSENT_DAYS=
RETENTION_FAILED_JOBS_DAYS=
RETENTION_PASSWORD_RESET_DAYS=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=raoza
DB_USERNAME=raoza
DB_PASSWORD=
DB_SSLMODE=prefer
DB_APPLICATION_NAME=raoza-local
DB_SSLCERT=
DB_SSLKEY=
DB_SSLROOTCERT=
# MariaDB/Hostinger alternative (select with DB_CONNECTION=mysql):
# DB_PORT=3306
# DB_SOCKET=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci
# DB_ISOLATION_LEVEL="READ COMMITTED"
# MYSQL_ATTR_SSL_CA=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="local@raoza.invalid"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"

PAYMENT_PROVIDER=mollie
MOLLIE_API_KEY=
MOLLIE_API_BASE_URL=https://api.mollie.com/v2
PAYMENT_CREATION_RETRY_MINUTES=45
PAYMENT_CREATION_CLAIM_MINUTES=2

CONSENT_POLICY_VERSION=2026-09-v1
ANALYTICS_PROVIDER=none
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# Set true behind HTTPS in production
SESSION_SECURE_COOKIE=false

# Production/deployment metadata. Override outside source control.
APP_RELEASE=local
PRODUCTION_CANONICAL_URL=https://raoza.nl
BACKUP_RETENTION_DAYS=14

# Local review mode only. Keep false in production.
RAOZA_DEMO_MODE=false
COMMERCE_VAT_RATE_BPS=2100
PENDING_ORDER_RESERVATION_MINUTES=30

# Official accounting documents stay disabled until these values and the legal
# seller profile in Admin > Store are explicitly approved by the owner/accountant.
INVOICE_ISSUANCE_ENABLED=false
INVOICE_ACCOUNTING_POLICY_APPROVED=false
INVOICE_SELLER_PROFILE_APPROVED=false
INVOICE_NUMBERING_APPROVED=false
INVOICE_NUMBERING_SCOPE=
INVOICE_NUMBER_PREFIX=
CREDIT_NOTE_NUMBER_PREFIX=
INVOICE_NUMBER_PADDING=6
CREDIT_NOTE_ALLOCATION_METHOD=
INVOICE_FILESYSTEM_DISK=local
