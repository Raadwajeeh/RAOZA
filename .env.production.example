# SANITIZED TEMPLATE ONLY. Copy to the host secret store; never commit a populated production .env.
APP_NAME=RAOZA
APP_ENV=production
APP_KEY=base64:OWNER_OR_OPERATOR_GENERATES_A_UNIQUE_KEY
APP_DEBUG=false
APP_URL=https://raoza.nl
PRODUCTION_CANONICAL_URL=https://raoza.nl
APP_RELEASE=GIT_SHA_OR_RELEASE_ID
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Leave empty only when the HTTPS edge connects directly to PHP; otherwise list host-supplied proxy IPs/CIDRs.
TRUSTED_PROXIES=OWNER_OR_HOST_SUPPLIED_PROXY_IPS_OR_CIDRS

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=HOSTINGER_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=raoza_production
DB_USERNAME=raoza_application
DB_PASSWORD=SECRET_FROM_HOST_STORE
DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ISOLATION_LEVEL="READ COMMITTED"
# Set only when Hostinger supplies a CA for a remote database connection. A local
# loopback/socket connection is accepted without TLS by production:preflight.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids

# Must point to persistent storage shared across releases and included in media backups.
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=OWNER_SELECTED_TRANSACTIONAL_MAIL_HOST
MAIL_PORT=587
MAIL_USERNAME=SECRET_FROM_HOST_STORE
MAIL_PASSWORD=SECRET_FROM_HOST_STORE
# Use smtp for STARTTLS/587 or smtps for implicit TLS/465, as required by the selected provider.
MAIL_SCHEME=smtp
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS=OWNER_VERIFIED_SENDER_ADDRESS
MAIL_FROM_NAME=RAOZA

PAYMENT_PROVIDER=mollie
MOLLIE_API_KEY=SECRET_FROM_HOST_STORE
MOLLIE_API_BASE_URL=https://api.mollie.com/v2
PAYMENT_CREATION_RETRY_MINUTES=45
PAYMENT_CREATION_CLAIM_MINUTES=2
RAOZA_DEMO_MODE=false

COMMERCE_VAT_RATE_BPS=OWNER_ACCOUNTANT_VERIFIED_BASIS_POINTS
PENDING_ORDER_RESERVATION_MINUTES=30
CONSENT_POLICY_VERSION=OWNER_LEGAL_APPROVED_VERSION
ANALYTICS_PROVIDER=none
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

RETENTION_PRUNING_ENABLED=false
RETENTION_ANALYTICS_DAYS=
RETENTION_SESSIONS_DAYS=
RETENTION_CONSENT_DAYS=
RETENTION_FAILED_JOBS_DAYS=
RETENTION_PASSWORD_RESET_DAYS=

# Used by the protected backup job, not by web requests.
BACKUP_DIR=/home/account/domains/raoza.raadwajeeh.com/backups
BACKUP_RETENTION_DAYS=14
# Path to a chmod-600 MariaDB client file outside public_html and source control.
BACKUP_MYSQL_DEFAULTS_FILE=/home/account/.config/raoza-backup.cnf
