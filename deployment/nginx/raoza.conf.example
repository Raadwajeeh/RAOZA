server {
    listen 80;
    server_name raoza.nl www.raoza.nl;
    return 301 https://raoza.nl$request_uri;
}

server {
    listen 443 ssl http2;
    server_name raoza.nl;

    root /var/www/raoza/current/public;
    index index.php;
    client_max_body_size 12m;

    # Configure certificates on the host; never commit private keys.
    ssl_certificate     /etc/letsencrypt/live/raoza.nl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/raoza.nl/privkey.pem;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ /\.(?!well-known).* { deny all; }
}
