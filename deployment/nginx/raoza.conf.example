server {
    listen 80;
    server_name raoza.nl www.raoza.nl;
    server_tokens off;
    return 301 https://raoza.nl$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.raoza.nl;
    server_tokens off;

    # The certificate must cover both raoza.nl and www.raoza.nl before this redirect is enabled.
    ssl_certificate     /etc/letsencrypt/live/raoza.nl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/raoza.nl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://raoza.nl$request_uri;
}

server {
    listen 443 ssl http2;
    server_name raoza.nl;
    server_tokens off;

    root /var/www/raoza/current/public;
    index index.php;
    client_max_body_size 12m;

    # Configure certificates on the host; never commit private keys.
    ssl_certificate     /etc/letsencrypt/live/raoza.nl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/raoza.nl/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Enable only after HTTPS and every intended subdomain are confirmed.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTPS on;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }

    location ~ \.php$ { return 404; }

    location ~ /\.(?!well-known).* { deny all; }
}
